# Example names only. Never commit live values or paste secrets into chat.
# Original managed Manus services should be reattached, not reprovisioned or copied to a new account.
PORT=3000
PUBLIC_APP_URL=
APP_ORIGIN=
# Exact comma-separated HTTPS origins, no wildcards. Include the actual authorised Preview when testing.
TRUSTED_ORIGINS=
ALLOWED_ORIGINS=
DATABASE_URL=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
# Optional public configuration; these values are baked into the frontend build.
VITE_CAL_LINK=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
# Public destinations only: confirm the owned profile/invite before setting.
# Leave empty rather than using the currently mismatched @bio.science profile.
VITE_INSTAGRAM_PROFILE_URL=
# Optional public post/Reel URL; defaults to the configured profile.
VITE_INSTAGRAM_EMBED_URL=
VITE_DISCORD_INVITE_URL=
# Requires the correct invite and the owner-enabled public server widget.
VITE_DISCORD_WIDGET_SERVER_ID=
# Adopted legacy aliases are documented in server/_core/README.md; do not duplicate mismatched project keys.

# 10November owner-selected Shopify source route (public provider changes require rebuild).
COMMERCE_PROVIDER=shopify
VITE_COMMERCE_PROVIDER=shopify
# On Manus, these are managed by the existing-store integration card. Do not enter/replace them manually.
# SHOPIFY_STORE_DOMAIN and SHOPIFY_STOREFRONT_ACCESS_TOKEN are automatically injected after binding/selection.
# This source's validated fallback reference is6v43dx-ck.myshopify.com; it does not prove a connected channel.
SHOPIFY_API_VERSION=2026-10
SHOPIFY_STOREFRONT_ENABLED=true
# Dedicated strong PRIVATE cart-cookie secret; never VITE_ or committed live values.
SHOPIFY_CART_COOKIE_SECRET=
# Exact authorised origins; no wildcards, paths, null origins or Host-derived trust.
SHOPIFY_CART_ALLOWED_ORIGINS=
# Keep closed until the owner approves real existing service IDs/scope and channel/terms.
SHOPIFY_CHECKOUT_ENABLED=false
SHOPIFY_APPROVED_SERVICE_PRODUCT_IDS=
# Optional SELF-HOSTED legitimate scoped access only; leave empty in managed Manus.
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=
# New Shopify purchases are NOT automatically mapped to this source account/points ledger.
